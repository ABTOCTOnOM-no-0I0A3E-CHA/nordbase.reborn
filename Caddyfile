# Caddy сам получает и продлевает сертификат Let's Encrypt для SITE_DOMAIN.

{$SITE_DOMAIN} {
	encode zstd gzip

	handle /uploads/* {
		# Отдаём с диска мимо Node: имя файла содержит uuid, поэтому старый
		# URL никогда не поменяет содержимое и его можно кешировать навсегда.
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		file_server
	}

	handle {
		reverse_proxy app:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
}
