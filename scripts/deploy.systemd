# Установка на сервере (от пользователя, под которым живёт ~/nordbase):
#
#   sudo cp scripts/deploy.systemd /tmp/nb && sudo sh -c 'csplit -sz -f /etc/systemd/system/nordbase-deploy. /tmp/nb "/^### /" "{*}"'
#
# Проще руками — два файла ниже, разделённые строками «### имя».
# Затем: sudo systemctl daemon-reload && sudo systemctl enable --now nordbase-deploy.timer
#
# Смотреть работу:  journalctl -u nordbase-deploy -n 50 --no-pager
# Остановить:       sudo systemctl disable --now nordbase-deploy.timer

### nordbase-deploy.service
[Unit]
Description=Автодеплой nordbase из GitHub
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=user
WorkingDirectory=/home/user/nordbase
# flock -n: сборка идёт дольше минуты, а таймер тикает каждую минуту —
# без замка запуски наложились бы друг на друга.
ExecStart=/usr/bin/flock -n /tmp/nordbase-deploy.lock /home/user/nordbase/scripts/deploy.sh

### nordbase-deploy.timer
[Unit]
Description=Проверять обновления nordbase раз в минуту

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
