# Скопировать в .env и заполнить. Реальные значения не коммитить.

DATABASE_URL=postgres://nordbase:nordbase@localhost:5432/nordbase
SESSION_COOKIE_NAME=nb_session

# Уведомления о заявках.
# В России api.telegram.org недоступен напрямую — задайте одно из двух:
#   TELEGRAM_API_BASE  — свой обратный прокси на зарубежном VPS,
#                        например https://tg.example.com (nginx → api.telegram.org)
#   TELEGRAM_PROXY_URL — HTTP(S)-прокси, например http://user:pass@1.2.3.4:8080
# SOCKS5 напрямую не поддерживается: поднимите http-мост или используйте API_BASE.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=
TELEGRAM_PROXY_URL=

# Объектное хранилище под медиатеку (Selectel / Yandex Object Storage)
S3_ENDPOINT=
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Абсолютный адрес сайта — нужен sitemap, robots и разметке для поисковиков
SITE_URL=http://localhost:3000

# Только для docker-compose.prod.yml
SITE_DOMAIN=nordbase.ru
POSTGRES_PASSWORD=

# Где приложение слушает на сервере. Значение по умолчанию — только петля:
# наружу сайт отдаёт прокси. Если прокси живёт в другом контейнере или на
# другой машине, укажите 0.0.0.0:3000 и закройте порт фаерволом.
APP_PORT=127.0.0.1:3000
